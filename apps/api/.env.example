NODE_ENV=development
PORT=4002
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bot_adtech?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_16_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_16_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=bot_AdTech
JWT_AUDIENCE=bot_AdTech_api

TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=change_me_bot_username
TELEGRAM_AUTOSTART=false
TELEGRAM_STARTUP_TEST=false
TELEGRAM_SEND_MAX_ATTEMPTS=3
TELEGRAM_SEND_BASE_DELAY_MS=1000
TELEGRAM_TIMEOUT_MS=25000
TELEGRAM_INTERNAL_TOKEN=CHANGE_ME_TELEGRAM_INTERNAL_TOKEN
INTERNAL_API_TOKEN=CHANGE_ME_INTERNAL_API_TOKEN
TELEGRAM_BACKEND_URL=http://localhost:4002

WORKER_MODE=false
WORKER_AUTOSTART=false
ENABLE_SWAGGER=true
ENABLE_LEDGER_INVARIANT_CHECK=true
ENABLE_CLICK=false
ENABLE_CLICK_PAYMENTS=false
ENABLE_WITHDRAWALS=false
KILL_SWITCH_DEV_TOPUP=false
LOG_LEVEL=log,error,warn,debug,verbose

CLICK_API_BASE_URL=https://api.click.uz
CLICK_CREATE_INVOICE_PATH=/v2/merchant/invoice/create
CLICK_GET_INVOICE_STATUS_PATH=/v2/merchant/invoice/status
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_USER_ID=
CLICK_SECRET_KEY=
CLICK_TIMEOUT_MS=15000
CLICK_SIGN_TIME_WINDOW_MINUTES=10
CLICK_AMOUNT_MODE=usd_decimal
USD_TO_UZS_RATE=

PUBLIC_BASE_URL=http://localhost:4002
